# Production configuration for the MMMUT server.
#
# Copy to .env on the server, fill in every value, then:
#   chmod 600 .env
#
# Never commit the real file. It contains the keys to every account.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=4000

# --- Database --------------------------------------------------------------
# The application user should own only this database — not a superuser.
DATABASE_URL="postgresql://zonal:REPLACE_WITH_A_STRONG_PASSWORD@localhost:5432/zonal?schema=public"

# --- Auth ------------------------------------------------------------------
# Generate a fresh one. The server refuses to start in production if this is
# missing, shorter than 32 characters, or still the development default:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing it later signs everyone out. That is the correct response to a leak.
JWT_SECRET=

# Long-lived because this is a phone app people keep installed. Shorten it if
# the university requires more frequent re-authentication.
JWT_EXPIRES_IN=30d

# --- Public address --------------------------------------------------------
# The URL users reach this API on, including scheme. Used to build media links.
PUBLIC_URL=https://clean.mmmut.ac.in

# Browser origins allowed to call the API. The mobile app is not affected by
# CORS; this matters if a web dashboard is added later. Comma-separated.
# The server refuses to start in production if this is empty.
CORS_ORIGINS=https://clean.mmmut.ac.in

# Express is behind nginx, so it must trust one proxy hop to see real client
# IPs. Without this, rate limiting treats every user as the same IP.
TRUST_PROXY=1

# --- Uploads ---------------------------------------------------------------
# Absolute path OUTSIDE the deploy directory, so a redeploy cannot delete
# months of complaint photos.
UPLOAD_DIR=/var/lib/zonal/uploads

MAX_PHOTO_MB=10
MAX_VIDEO_MB=25
MAX_AUDIO_MB=5
MAX_VIDEO_SECONDS=30
MAX_AUDIO_SECONDS=60

# --- Business rules --------------------------------------------------------
# Hours. Tune these with the estate office once real timings are known.
SLA_OFFICER_ALLOT_HOURS=0.5
SLA_WORKER_COMPLETE_HOURS=24
HELP_REQUEST_EXPIRY_HOURS=0.5
# 0 = never close a complaint without its reporter. A complaint sits in
# WORK_DONE until the person who filed it signs it off; a timer that decides
# on their behalf turns an unresolved problem into a resolved-looking
# statistic. Set a positive number of hours only for a deliberate backstop.
AUTO_CLOSE_HOURS=0
MAX_REOPEN_COUNT=1
MAX_TASKS_PER_WORKER=1

# How far a resident may correct the GPS pin, in metres.
MAX_PIN_ADJUST_METERS=150

# --- Rate limits -----------------------------------------------------------
# Counted per signed-in user, falling back to IP for anonymous requests.
# That matters on a campus: hundreds of people share one NAT address, so a
# purely IP-based limit would let one script throttle a whole hostel.
#
# Verify after changing:  npm run test:ratelimit
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MIN=1
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MIN=10

# --- Insights --------------------------------------------------------------
RECURRENCE_WINDOW_DAYS=7
INSIGHT_WINDOW_DAYS=30
INSIGHT_HOTSPOT_MIN_COMPLAINTS=4
INSIGHT_MIN_COMPLAINTS_FOR_STAFFING=15

# --- Campus centre ---------------------------------------------------------
# MMMUT Gorakhpur. Only used as a map starting point; the real boundaries come
# from what the admin draws.
CAMPUS_CENTER_LAT=26.7314
CAMPUS_CENTER_LNG=83.4324
