# Copy this file to .env and fill in your real values.

# --- Database -------------------------------------------------------------
# Points at the Postgres container from docker-compose.yml (host port 5433,
# chosen so it does not collide with a local Postgres on 5432).
#   docker compose up -d
# To use a local Postgres instead, swap in your own credentials and port.
DATABASE_URL="postgresql://zonal:zonal_dev_password@localhost:5433/zonal?schema=public"

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- Auth -----------------------------------------------------------------
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR="uploads"
MAX_PHOTO_MB=10
MAX_VIDEO_MB=25
MAX_AUDIO_MB=5
MAX_VIDEO_SECONDS=30
MAX_AUDIO_SECONDS=60

# --- Business rules (hours) ----------------------------------------------
# Officer must allot within this window before it surfaces to Admin
SLA_OFFICER_ALLOT_HOURS=0.5
# Worker must finish within this window before the complaint is escalated
SLA_WORKER_COMPLETE_HOURS=24
# Unanswered officer-to-officer help request expires to Admin after this
HELP_REQUEST_EXPIRY_HOURS=0.5
# Resident silent for this long after WORK_DONE -> AUTO_CLOSED
# 0 = never close a complaint without its reporter. A complaint sits in
# WORK_DONE until the person who filed it signs it off; a timer that decides
# on their behalf turns an unresolved problem into a resolved-looking
# statistic. Set a positive number of hours only for a deliberate backstop.
AUTO_CLOSE_HOURS=0
# How many times a resident may reject before it escalates to Admin
MAX_REOPEN_COUNT=1
# Live tasks a single worker may hold at once
MAX_TASKS_PER_WORKER=1
